# [CALCITE-2391] Aggregate query with UNNEST or LATERAL fails with ClassCastException
select count(*) as c
from "scott".dept,
  lateral (select * from "scott".emp where emp.deptno = dept.deptno) as e;
+----+
| C  |
+----+
| 14 |
+----+
(1 row)

!ok

# LATERAL plus CTEs (WITH)
with dept (deptno, dname)
    as (values (10, 'ACCOUNTING'), (20, 'RESEARCH')),
  emp (empno, deptno, ename)
    as (values (7369, 20, 'SMITH'), (7782, 10, 'CLARK'), (7499, 30, 'ALLEN'))
select *
from dept,
  lateral (select * from emp where emp.deptno = dept.deptno) as emp;
+--------+------------+-------+---------+-------+
| DEPTNO | DNAME      | EMPNO | DEPTNO0 | ENAME |
+--------+------------+-------+---------+-------+
|     10 | ACCOUNTING |  7782 |      10 | CLARK |
|     20 | RESEARCH   |  7369 |      20 | SMITH |
+--------+------------+-------+---------+-------+
(2 rows)

!ok

# [CALCITE-6266] SqlValidatorException with LATERAL TABLE and JOIN
# The problem also occurred in ', LATERAL (SELECT ...) JOIN'. 'JOIN' binds
# tighter than ',', so the LATERAL item is inside a join, and it must see
# the items before the ','. Same result on PostgreSQL 14.
with dept (deptno, dname)
    as (values (10, 'ACCOUNTING'), (20,'RESEARCH')),
  emp (empno, deptno, ename)
    as (values (7369, 20, 'SMITH'), (7782, 10, 'CLARK'), (7499, 30, 'ALLEN'))
select *
from dept,
  lateral (select * from emp where emp.deptno = dept.deptno) as emp
  cross join (values 'A', 'B') as v (v);
+--------+------------+-------+---------+-------+---+
| DEPTNO | DNAME      | EMPNO | DEPTNO0 | ENAME | V |
+--------+------------+-------+---------+-------+---+
|     10 | ACCOUNTING |  7782 |      10 | CLARK | A |
|     10 | ACCOUNTING |  7782 |      10 | CLARK | B |
|     20 | RESEARCH   |  7369 |      20 | SMITH | A |
|     20 | RESEARCH   |  7369 |      20 | SMITH | B |
+--------+------------+-------+---------+-------+---+
(4 rows)

!ok

# [CALCITE-7911] FROM a, b JOIN c is parsed incorrectly
# LATERAL on the right of a join sees the item on the left of the join (v)
# and the item before the ',' (dept). Same result on PostgreSQL 14.
with dept (deptno, dname)
    as (values (10, 'ACCOUNTING'), (20,'RESEARCH')),
  emp (empno, deptno, ename)
    as (values (7369, 20, 'SMITH'), (7782, 10, 'CLARK'), (7499, 30, 'ALLEN'))
select *
from dept,
  (values 'A', 'M') as v (v)
  cross join lateral (select * from emp
    where emp.deptno = dept.deptno
    and position(v.v in emp.ename) > 0) as emp;
+--------+------------+---+-------+---------+-------+
| DEPTNO | DNAME      | V | EMPNO | DEPTNO0 | ENAME |
+--------+------------+---+-------+---------+-------+
|     10 | ACCOUNTING | A |  7782 |      10 | CLARK |
|     20 | RESEARCH   | M |  7369 |      20 | SMITH |
+--------+------------+---+-------+---------+-------+
(2 rows)

!ok

# As above, with LEFT JOIN; a row of v that has no match in emp still appears
# once for each dept, with a null ENAME. Same result on PostgreSQL 14.
with dept (deptno, dname)
    as (values (10, 'ACCOUNTING'), (20,'RESEARCH')),
  emp (empno, deptno, ename)
    as (values (7369, 20, 'SMITH'), (7782, 10, 'CLARK'), (7499, 30, 'ALLEN'))
select dept.deptno, emp.ename, v.v
from dept,
  (values ('A'), ('M')) as v (v)
  left join lateral (select * from emp
    where emp.deptno = dept.deptno
    and position(v.v in emp.ename) > 0) as emp on true;
+--------+-------+---+
| DEPTNO | ENAME | V |
+--------+-------+---+
|     10 | CLARK | A |
|     10 |       | M |
|     20 | SMITH | M |
|     20 |       | A |
+--------+-------+---+
(4 rows)

!ok

# [CALCITE-7911] FROM a, b JOIN c is parsed incorrectly
# LATERAL sees two items before the ',' (v1 and dept) and the item on the
# left of the join (v2). Same result on PostgreSQL 14.
with dept (deptno, dname)
    as (values (10, 'ACCOUNTING'), (20,'RESEARCH')),
  emp (empno, deptno, ename)
    as (values (7369, 20, 'SMITH'), (7782, 10, 'CLARK'), (7499, 30, 'ALLEN'))
select v1.v as v1, dept.deptno, emp.ename, v2.v as v2
from (values ('A'), ('M')) as v1 (v),
  dept,
  (values ('A'), ('M')) as v2 (v)
  cross join lateral (select * from emp
    where emp.deptno = dept.deptno
    and position(v2.v in emp.ename) > 0
    and v1.v = 'A') as emp;
+----+--------+-------+----+
| V1 | DEPTNO | ENAME | V2 |
+----+--------+-------+----+
| A  |     10 | CLARK | A  |
| A  |     20 | SMITH | M  |
+----+--------+-------+----+
(2 rows)

!ok

# [CALCITE-7911] FROM a, b JOIN c is parsed incorrectly
# LATERAL on the right of a join uses a column of the join's left input (v.v)
# two times. Same result on PostgreSQL 14.
with dept (deptno, dname)
    as (values (10, 'ACCOUNTING'), (20,'RESEARCH')),
  emp (empno, deptno, ename)
    as (values (7369, 20, 'SMITH'), (7782, 10, 'CLARK'), (7499, 30, 'ALLEN'))
select dept.deptno, emp.ename, v.v
from dept,
  (values ('A'), ('M')) as v (v)
  cross join lateral (select * from emp
    where emp.deptno = dept.deptno
    and position(v.v in emp.ename) > 0
    and position(v.v in emp.ename) < 4) as emp;
+--------+-------+---+
| DEPTNO | ENAME | V |
+--------+-------+---+
|     10 | CLARK | A |
|     20 | SMITH | M |
+--------+-------+---+
(2 rows)

!ok

# UNNEST applied to VALUES
with t (x, ys)
  as (values (1, array [2,3]), (4, array [5]))
select *
from t,
  unnest(t.ys) as y;
+---+--------+---+
| X | YS     | Y |
+---+--------+---+
| 1 | [2, 3] | 2 |
| 1 | [2, 3] | 3 |
| 4 | [5]    | 5 |
+---+--------+---+
(3 rows)

!ok

# LATERAL UNNEST means the same as UNNEST
# (Have checked Postgres)
with t (x, ys)
  as (values (1, array [2,3]), (4, array [5]))
select *
from t,
  lateral unnest(t.ys) as y;
+---+--------+---+
| X | YS     | Y |
+---+--------+---+
| 1 | [2, 3] | 2 |
| 1 | [2, 3] | 3 |
| 4 | [5]    | 5 |
+---+--------+---+
(3 rows)

!ok

# LEFT JOIN LATERAL
select ename, deptno, ename2
from emp as o
  left join lateral (select ename as ename2
                     from emp
                     where deptno = o.deptno + 10) on true
where job = 'MANAGER';
+-------+--------+--------+
| ENAME | DEPTNO | ENAME2 |
+-------+--------+--------+
| BLAKE |     30 |        |
| CLARK |     10 | ADAMS  |
| CLARK |     10 | FORD   |
| CLARK |     10 | JONES  |
| CLARK |     10 | SCOTT  |
| CLARK |     10 | SMITH  |
| JONES |     20 | ALLEN  |
| JONES |     20 | BLAKE  |
| JONES |     20 | JAMES  |
| JONES |     20 | MARTIN |
| JONES |     20 | TURNER |
| JONES |     20 | WARD   |
+-------+--------+--------+
(12 rows)

!ok

